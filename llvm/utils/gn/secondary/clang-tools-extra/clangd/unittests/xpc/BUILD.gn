import("//build_overrides/llvm.gni")

import("${llvm_root_dir}third-party/unittest/unittest.gni")

unittest("ClangdXpcTests") {
  configs += [ "${llvm_root_dir}llvm/utils/gn/build:clang_code" ]
  deps = [
    "${llvm_root_dir}clang-tools-extra/clangd",
    "${llvm_root_dir}clang-tools-extra/clangd/xpc:conversions",
    "${llvm_root_dir}llvm/lib/Support",
    "${llvm_root_dir}llvm/lib/Testing/Support",
  ]
  include_dirs = [ "${llvm_root_dir}clang-tools-extra/clangd" ]
  sources = [ "ConversionTests.cpp" ]
}
