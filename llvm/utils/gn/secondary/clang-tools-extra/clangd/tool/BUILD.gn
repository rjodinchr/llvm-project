import("//build_overrides/llvm.gni")

import("${llvm_root_dir}clang-tools-extra/clangd/xpc/enable.gni")

llvm_executable("clangd") {
  configs += [ "${llvm_root_dir}llvm/utils/gn/build:clang_code" ]
  deps = [
    "${llvm_root_dir}clang-tools-extra/clang-tidy",
    "${llvm_root_dir}clang-tools-extra/clangd",
    "${llvm_root_dir}clang-tools-extra/clangd:features",
    "${llvm_root_dir}clang-tools-extra/clangd/index/remote/unimplemented",
    "${llvm_root_dir}clang-tools-extra/clangd/refactor/tweaks",
    "${llvm_root_dir}clang/lib/AST",
    "${llvm_root_dir}clang/lib/Basic",
    "${llvm_root_dir}clang/lib/Format",
    "${llvm_root_dir}clang/lib/Frontend",
    "${llvm_root_dir}clang/lib/Headers",
    "${llvm_root_dir}clang/lib/Sema",
    "${llvm_root_dir}clang/lib/Tooling",
    "${llvm_root_dir}clang/lib/Tooling/Core",
    "${llvm_root_dir}llvm/lib/Support",
  ]
  if (clangd_build_xpc) {
    deps += [
      "${llvm_root_dir}clang-tools-extra/clangd/xpc:conversions",
      "${llvm_root_dir}clang-tools-extra/clangd/xpc:transport",
    ]
  }

  include_dirs = [
    "..",

    # For "clang-include-cleaner/..." includes.
    "${llvm_root_dir}clang-tools-extra/include-cleaner/include",
  ]
  sources = [
    "Check.cpp",
    "ClangdMain.cpp",
    "ClangdToolMain.cpp",
  ]
}
