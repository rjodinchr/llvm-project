import("//build_overrides/llvm.gni")

import("${llvm_root_dir}third-party/unittest/unittest.gni")

unittest("ClangTidyTests") {
  configs += [ "${llvm_root_dir}llvm/utils/gn/build:clang_code" ]
  deps = [
    "${llvm_root_dir}clang-tools-extra/clang-tidy",
    "${llvm_root_dir}clang-tools-extra/clang-tidy/android",
    "${llvm_root_dir}clang-tools-extra/clang-tidy/google",
    "${llvm_root_dir}clang-tools-extra/clang-tidy/llvm",
    "${llvm_root_dir}clang-tools-extra/clang-tidy/misc",
    "${llvm_root_dir}clang-tools-extra/clang-tidy/modernize",
    "${llvm_root_dir}clang-tools-extra/clang-tidy/objc",
    "${llvm_root_dir}clang-tools-extra/clang-tidy/readability",
    "${llvm_root_dir}clang-tools-extra/clang-tidy/utils",
    "${llvm_root_dir}clang/lib/AST",
    "${llvm_root_dir}clang/lib/ASTMatchers",
    "${llvm_root_dir}clang/lib/Basic",
    "${llvm_root_dir}clang/lib/Frontend",
    "${llvm_root_dir}clang/lib/Lex",
    "${llvm_root_dir}clang/lib/Serialization",
    "${llvm_root_dir}clang/lib/Testing",
    "${llvm_root_dir}clang/lib/Tooling",
    "${llvm_root_dir}clang/lib/Tooling/Core",
    "${llvm_root_dir}clang/lib/Tooling/Transformer",
    "${llvm_root_dir}llvm/lib/Support",
    "${llvm_root_dir}llvm/lib/Testing/Annotations",
    "${llvm_root_dir}llvm/lib/Testing/Support",
  ]
  include_dirs = [
    "${llvm_root_dir}clang-tools-extra/clang-tidy",
    "${llvm_root_dir}clang-tools-extra/include-cleaner/include",
  ]
  sources = [
    "AddConstTest.cpp",
    "ClangTidyDiagnosticConsumerTest.cpp",
    "ClangTidyOptionsTest.cpp",
    "DeclRefExprUtilsTest.cpp",
    "GlobListTest.cpp",
    "GoogleModuleTest.cpp",
    "IncludeCleanerTest.cpp",
    "IncludeInserterTest.cpp",
    "LLVMModuleTest.cpp",
    "ModernizeModuleTest.cpp",
    "NamespaceAliaserTest.cpp",
    "ObjCModuleTest.cpp",
    "OptionsProviderTest.cpp",
    "OverlappingReplacementsTest.cpp",
    "ReadabilityModuleTest.cpp",
    "TransformerClangTidyCheckTest.cpp",
    "UsingInserterTest.cpp",
  ]
}
