import("//build_overrides/llvm.gni")

llvm_static_library("utils") {
  output_name = "clangTidyUtils"
  configs += [ "${llvm_root_dir}llvm/utils/gn/build:clang_code" ]
  deps = [
    "${llvm_root_dir}clang-tools-extra/clang-tidy",
    "${llvm_root_dir}clang/lib/AST",
    "${llvm_root_dir}clang/lib/ASTMatchers",
    "${llvm_root_dir}clang/lib/Basic",
    "${llvm_root_dir}clang/lib/Lex",
    "${llvm_root_dir}clang/lib/Tooling/Transformer",
    "${llvm_root_dir}llvm/lib/Support",
  ]
  sources = [
    "ASTUtils.cpp",
    "Aliasing.cpp",
    "BracesAroundStatement.cpp",
    "DeclRefExprUtils.cpp",
    "DesignatedInitializers.cpp",
    "ExceptionAnalyzer.cpp",
    "ExceptionSpecAnalyzer.cpp",
    "ExprSequence.cpp",
    "FileExtensionsUtils.cpp",
    "FixItHintUtils.cpp",
    "FormatStringConverter.cpp",
    "HeaderGuard.cpp",
    "IncludeInserter.cpp",
    "IncludeSorter.cpp",
    "LexerUtils.cpp",
    "Matchers.cpp",
    "NamespaceAliaser.cpp",
    "OptionsUtils.cpp",
    "RenamerClangTidyCheck.cpp",
    "TransformerClangTidyCheck.cpp",
    "TypeTraits.cpp",
    "UseRangesCheck.cpp",
    "UsingInserter.cpp",
  ]
}
