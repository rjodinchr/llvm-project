import("//build_overrides/llvm.gni")

llvm_executable("clang-offload-packager") {
  configs += [ "${llvm_root_dir}llvm/utils/gn/build:clang_code" ]
  deps = [
    "${llvm_root_dir}clang/lib/Basic",
    "${llvm_root_dir}llvm/lib/Object",
    "${llvm_root_dir}llvm/lib/Support",
    "${llvm_root_dir}llvm/lib/Target:TargetsToBuild",
  ]
  sources = [ "ClangOffloadPackager.cpp" ]
}
