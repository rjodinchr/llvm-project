import("//build_overrides/llvm.gni")

llvm_executable("diagtool") {
  configs += [ "${llvm_root_dir}llvm/utils/gn/build:clang_code" ]
  deps = [
    "${llvm_root_dir}clang/include/clang/Basic:DiagnosticIndexName",
    "${llvm_root_dir}clang/lib/Basic",
    "${llvm_root_dir}clang/lib/Frontend",
    "${llvm_root_dir}llvm/lib/Support",
  ]
  sources = [
    "DiagTool.cpp",
    "DiagnosticNames.cpp",
    "FindDiagnosticID.cpp",
    "ListWarnings.cpp",
    "ShowEnabledWarnings.cpp",
    "TreeView.cpp",
    "diagtool_main.cpp",
  ]
}
