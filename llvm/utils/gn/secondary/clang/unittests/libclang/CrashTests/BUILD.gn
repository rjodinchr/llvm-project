import("//build_overrides/llvm.gni")

import("${llvm_root_dir}third-party/unittest/unittest.gni")

unittest("libclangCrashTests") {
  configs += [ "${llvm_root_dir}llvm/utils/gn/build:clang_code" ]
  deps = [ "${llvm_root_dir}clang/tools/libclang" ]
  sources = [ "LibclangCrashTest.cpp" ]
  if (host_os == "mac") {
    ldflags = [ "-Wl,-rpath," + rebase_path("$root_out_dir/lib") ]
  }
}
