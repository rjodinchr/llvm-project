import("//build_overrides/llvm.gni")

llvm_static_library("Syntax") {
  output_name = "clangToolingSyntax"
  configs += [ "${llvm_root_dir}llvm/utils/gn/build:clang_code" ]
  deps = [
    "${llvm_root_dir}clang/include/clang/Tooling/Syntax:Nodes",
    "${llvm_root_dir}clang/lib/Basic",
    "${llvm_root_dir}clang/lib/Frontend",
    "${llvm_root_dir}clang/lib/Lex",
    "${llvm_root_dir}llvm/lib/Support",
  ]
  public_deps = [ "${llvm_root_dir}clang/include/clang/Tooling/Syntax:NodeClasses" ]
  sources = [
    "BuildTree.cpp",
    "ComputeReplacements.cpp",
    "Mutations.cpp",
    "Nodes.cpp",
    "Synthesis.cpp",
    "TokenBufferTokenManager.cpp",
    "Tokens.cpp",
    "Tree.cpp",
  ]
}
