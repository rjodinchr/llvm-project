import("//build_overrides/llvm.gni")

llvm_static_library("APINotes") {
  output_name = "clangAPINotes"
  configs += [ "${llvm_root_dir}llvm/utils/gn/build:clang_code" ]
  deps = [
    "${llvm_root_dir}clang/lib/Basic",
    "${llvm_root_dir}llvm/lib/Support",
  ]
  sources = [
    "APINotesManager.cpp",
    "APINotesReader.cpp",
    "APINotesTypes.cpp",
    "APINotesWriter.cpp",
    "APINotesYAMLCompiler.cpp",
  ]
}
