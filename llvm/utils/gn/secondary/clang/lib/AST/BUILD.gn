import("//build_overrides/llvm.gni")

import("${llvm_root_dir}clang/utils/TableGen/clang_tablegen.gni")

clang_tablegen("Opcodes") {
  visibility = [ ":AST" ]
  args = [ "-gen-clang-opcodes" ]
  td_file = "ByteCode/Opcodes.td"
}

clang_tablegen("AttrDocTable") {
  visibility = [ ":AST" ]
  args = [ "-gen-clang-attr-doc-table" ]
  td_file = "${llvm_root_dir}clang/include/clang/Basic/Attr.td"
}

llvm_static_library("AST") {
  output_name = "clangAST"
  configs += [ "${llvm_root_dir}llvm/utils/gn/build:clang_code" ]
  deps = [
    ":AttrDocTable",
    ":Opcodes",
    "${llvm_root_dir}clang/include/clang/AST:AttrImpl",
    "${llvm_root_dir}clang/include/clang/AST:AttrNodeTraverse",
    "${llvm_root_dir}clang/include/clang/AST:AttrTextNodeDump",
    "${llvm_root_dir}clang/include/clang/AST:CommentCommandInfo",
    "${llvm_root_dir}clang/include/clang/AST:CommentHTMLNamedCharacterReferences",
    "${llvm_root_dir}clang/include/clang/AST:CommentHTMLTags",
    "${llvm_root_dir}clang/include/clang/AST:CommentHTMLTagsProperties",
    "${llvm_root_dir}clang/include/clang/AST:DeclNodes",
    "${llvm_root_dir}clang/lib/Basic",
    "${llvm_root_dir}clang/lib/Lex",
    "${llvm_root_dir}llvm/lib/BinaryFormat",
    "${llvm_root_dir}llvm/lib/Frontend/OpenMP",
    "${llvm_root_dir}llvm/lib/Support",
    "${llvm_root_dir}llvm/lib/TargetParser",
  ]

  # Generated files used in public headers should be in public_deps, the rest
  # in regular deps.
  public_deps = [
    "${llvm_root_dir}clang/include/clang/AST:AbstractBasicReader",
    "${llvm_root_dir}clang/include/clang/AST:AbstractBasicWriter",
