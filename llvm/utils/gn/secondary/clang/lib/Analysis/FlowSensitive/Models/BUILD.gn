    "${llvm_root_dir}clang/lib/Analysis",
    "${llvm_root_dir}clang/lib/Analysis/FlowSensitive",
    "${llvm_root_dir}clang/lib/Basic",
  ]
  sources = [
    "ChromiumCheckModel.cpp",
    "UncheckedOptionalAccessModel.cpp",
  ]
