import("//build_overrides/llvm.gni")

llvm_static_library("Frontend") {
  output_name = "clangStaticAnalyzerFrontend"
  configs += [ "${llvm_root_dir}llvm/utils/gn/build:clang_code" ]
  deps = [
    "${llvm_root_dir}clang/lib/AST",
    "${llvm_root_dir}clang/lib/Analysis",
    "${llvm_root_dir}clang/lib/Basic",
    "${llvm_root_dir}clang/lib/CrossTU",
    "${llvm_root_dir}clang/lib/Frontend",
    "${llvm_root_dir}clang/lib/Lex",
    "${llvm_root_dir}clang/lib/StaticAnalyzer/Checkers",
    "${llvm_root_dir}clang/lib/StaticAnalyzer/Core",
    "${llvm_root_dir}llvm/lib/Support",
  ]
  sources = [
    "AnalysisConsumer.cpp",
    "AnalyzerHelpFlags.cpp",
    "CheckerRegistry.cpp",
    "CreateCheckerManager.cpp",
    "FrontendActions.cpp",
    "ModelConsumer.cpp",
    "ModelInjector.cpp",
  ]
}
