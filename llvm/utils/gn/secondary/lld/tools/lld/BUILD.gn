import("//build_overrides/llvm.gni")

import("${llvm_root_dir}llvm/utils/gn/build/driver_executable.gni")
import("${llvm_root_dir}llvm/utils/gn/build/symlink_or_copy.gni")

symlinks = [
  "lld-link",
  "ld.lld",
  "ld64.lld",
  "wasm-ld",
]
foreach(target, symlinks) {
  symlink_or_copy(target) {
    deps = [ ":lld" ]
    source = "lld"
    output = "$root_out_dir/bin/$target"
  }
}

# //:lld depends on this symlink target, see comment in //BUILD.gn.
group("symlinks") {
  deps = [ ":lld" ]
  foreach(target, symlinks) {
    deps += [ ":$target" ]
  }
}

driver_executable("lld") {
  configs += [ "${llvm_root_dir}llvm/utils/gn/build:lld_code" ]
  deps = [
    "${llvm_root_dir}lld/COFF",
    "${llvm_root_dir}lld/ELF",
    "${llvm_root_dir}lld/MachO:MachO",
    "${llvm_root_dir}lld/MinGW",
    "${llvm_root_dir}lld/wasm",
    "${llvm_root_dir}llvm/lib/Support",
    "${llvm_root_dir}llvm/lib/TargetParser",
    "${llvm_root_dir}llvm/utils/gn/build/libs/xar",
  ]
  assert_no_deps = [ "${llvm_root_dir}llvm/lib/Debuginfod" ]
  sources = [ "lld.cpp" ]
}
