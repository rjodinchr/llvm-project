import("//build_overrides/llvm.gni")

import("${llvm_root_dir}lldb/utils/TableGen/lldb_tablegen.gni")

lldb_tablegen("ObjectFilePECOFFProperties") {
  args = [ "-gen-lldb-property-defs" ]
}

lldb_tablegen("ObjectFilePECOFFPropertiesEnum") {
  args = [ "-gen-lldb-property-enum-defs" ]
  td_file = "ObjectFilePECOFFProperties.td"
}

llvm_static_library("PECOFF") {
  output_name = "lldbPluginObjectFilePECOFF"
  configs += [ "${llvm_root_dir}llvm/utils/gn/build:lldb_code" ]
  deps = [
    ":ObjectFilePECOFFProperties",
    ":ObjectFilePECOFFPropertiesEnum",
    "${llvm_root_dir}lldb/source/Core",
    "${llvm_root_dir}lldb/source/Host",
    "${llvm_root_dir}lldb/source/Symbol",
    "${llvm_root_dir}lldb/source/Target",
    "${llvm_root_dir}llvm/lib/BinaryFormat",
    "${llvm_root_dir}llvm/lib/Support",
    "${llvm_root_dir}llvm/lib/TargetParser",
  ]

  # Reaches into Plugins/Process/Utility.
  include_dirs = [ "${llvm_root_dir}lldb/source" ]
  sources = [
    "ObjectFilePECOFF.cpp",
    "PECallFrameInfo.cpp",
    "WindowsMiniDump.cpp",
  ]

  if (current_os == "win") {
    # Dbghelp is used on windows for writing minidump files.
    libs = [ "dbghelp.lib" ]
  }
}
