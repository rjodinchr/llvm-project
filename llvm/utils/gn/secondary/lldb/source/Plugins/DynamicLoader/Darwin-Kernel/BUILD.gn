import("//build_overrides/llvm.gni")

import("${llvm_root_dir}lldb/utils/TableGen/lldb_tablegen.gni")

lldb_tablegen("DynamicLoaderDarwinKernelProperties") {
  args = [ "-gen-lldb-property-defs" ]
}

lldb_tablegen("DynamicLoaderDarwinKernelPropertiesEnum") {
  args = [ "-gen-lldb-property-enum-defs" ]
  td_file = "DynamicLoaderDarwinKernelProperties.td"
}

llvm_static_library("Darwin-Kernel") {
  output_name = "lldbPluginDynamicLoaderDarwinKernel"
  configs += [ "${llvm_root_dir}llvm/utils/gn/build:lldb_code" ]
  deps = [
    ":DynamicLoaderDarwinKernelProperties",
    ":DynamicLoaderDarwinKernelPropertiesEnum",
    "${llvm_root_dir}lldb/source/Breakpoint",
    "${llvm_root_dir}lldb/source/Core",
    "${llvm_root_dir}lldb/source/Host",
    "${llvm_root_dir}lldb/source/Interpreter",
    "${llvm_root_dir}lldb/source/Symbol",
    "${llvm_root_dir}lldb/source/Target",
    "${llvm_root_dir}lldb/source/Utility",

    # "${llvm_root_dir}lldb/source/Plugins/Platform/MacOSX", # Dependency cycle
    "${llvm_root_dir}llvm/lib/Support",
  ]

  # Reaches into Plugins/Platform/MacOSX.
  include_dirs = [ "${llvm_root_dir}lldb/source" ]
  sources = [ "DynamicLoaderDarwinKernel.cpp" ]
}
