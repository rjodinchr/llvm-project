import("//build_overrides/llvm.gni")

import("${llvm_root_dir}third-party/unittest/unittest.gni")

unittest("AArch64Tests") {
  deps = [
    "${llvm_root_dir}llvm/lib/CodeGen",
    "${llvm_root_dir}llvm/lib/CodeGen/GlobalISel",
    "${llvm_root_dir}llvm/lib/CodeGen/MIRParser",
    "${llvm_root_dir}llvm/lib/CodeGen/SelectionDAG",
    "${llvm_root_dir}llvm/lib/Support",
    "${llvm_root_dir}llvm/lib/Target",
    "${llvm_root_dir}llvm/lib/Target/AArch64:LLVMAArch64CodeGen",
    "${llvm_root_dir}llvm/lib/Target/AArch64/MCTargetDesc",
    "${llvm_root_dir}llvm/lib/Target/AArch64/TargetInfo",
    "${llvm_root_dir}llvm/lib/Target/AArch64/Utils",
    "${llvm_root_dir}llvm/lib/TargetParser",
  ]
  include_dirs = [ "${llvm_root_dir}llvm/lib/Target/AArch64" ]
  sources = [
    "AArch64InstPrinterTest.cpp",
    "AArch64SVESchedPseudoTest.cpp",
    "AddressingModes.cpp",
    "DecomposeStackOffsetTest.cpp",
    "Immediates.cpp",
    "InstSizes.cpp",
    "MatrixRegisterAliasing.cpp",
    "SMEAttributesTest.cpp",
  ]
}
