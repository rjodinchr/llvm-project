import("//build_overrides/llvm.gni")

import("${llvm_root_dir}third-party/unittest/unittest.gni")

unittest("AMDGPUTests") {
  deps = [
    "${llvm_root_dir}llvm/lib/Support",
    "${llvm_root_dir}llvm/lib/Target",

    # AMDGPUBaseInfo.cpp includes GCNSubtarget.h which after 490e348e679
    # includes the generated AMDGPUGenRegisterBank.inc file :/
    "${llvm_root_dir}llvm/lib/Target/AMDGPU:LLVMAMDGPUCodeGen",
    "${llvm_root_dir}llvm/lib/Target/AMDGPU/:AMDGPUGenRegisterBank",
    "${llvm_root_dir}llvm/lib/Target/AMDGPU/MCTargetDesc",
    "${llvm_root_dir}llvm/lib/Target/AMDGPU/TargetInfo",
    "${llvm_root_dir}llvm/lib/Target/AMDGPU/Utils",
    "${llvm_root_dir}llvm/lib/TargetParser",
  ]
  include_dirs = [ "${llvm_root_dir}llvm/lib/Target/AMDGPU" ]
  sources = [
    "AMDGPUUnitTests.cpp",
    "DwarfRegMappings.cpp",
    "ExecMayBeModifiedBeforeAnyUse.cpp",
    "PALMetadata.cpp",
  ]
}
