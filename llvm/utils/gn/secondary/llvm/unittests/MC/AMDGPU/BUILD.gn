import("//build_overrides/llvm.gni")

import("${llvm_root_dir}third-party/unittest/unittest.gni")

unittest("AMDGPUMCTests") {
  deps = [
    "${llvm_root_dir}llvm/lib/CodeGen",
    "${llvm_root_dir}llvm/lib/IR",
    "${llvm_root_dir}llvm/lib/MC",
    "${llvm_root_dir}llvm/lib/MC/MCDisassembler",
    "${llvm_root_dir}llvm/lib/Support",
    "${llvm_root_dir}llvm/lib/Target/AMDGPU:LLVMAMDGPUCodeGen",
    "${llvm_root_dir}llvm/lib/Target/AMDGPU/Disassembler",
    "${llvm_root_dir}llvm/lib/Target/AMDGPU/MCTargetDesc",
    "${llvm_root_dir}llvm/lib/Target/AMDGPU/TargetInfo",
    "${llvm_root_dir}llvm/lib/TargetParser",

    # SIProgramInfoMCExprs.cpp includes AMDGPUTargetMachine.h, which includes
    # the generated AMDGPUGenRegisterBank.inc file :/
    "${llvm_root_dir}llvm/lib/Target/AMDGPU:AMDGPUGenRegisterBank",

    # SIProgramInfoMCExprs.cpp includes AMDGPUTargetMachine.h, which includes
    # the generated AMDGPUGenSearchableTables.inc file :/
    "${llvm_root_dir}llvm/lib/Target/AMDGPU/Utils:AMDGPUGenSearchableTables",
  ]

  # AMDGPUMCTests heavily reaches into lib/Target/AMDGPU internals.
  include_dirs = [ "${llvm_root_dir}llvm/lib/Target/AMDGPU" ]
  sources = [
    "Disassembler.cpp",
    "DwarfRegMappings.cpp",
  ]
}
