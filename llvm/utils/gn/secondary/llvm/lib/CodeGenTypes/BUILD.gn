import("//build_overrides/llvm.gni")

llvm_static_library("CodeGenTypes") {
  output_name = "LLVMCodeGenTypes"
  public_deps = [
    # Must be a public_dep because CodeGen's headers include llvm-config.h.
    "${llvm_root_dir}llvm/include/llvm/Config:llvm-config",
  ]
  deps = [
    "${llvm_root_dir}llvm/include/llvm/CodeGen:GenVT",
    "${llvm_root_dir}llvm/lib/Support",
  ]
  sources = [ "LowLevelType.cpp" ]
}
