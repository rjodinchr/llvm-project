import("//build_overrides/llvm.gni")

llvm_static_library("Utils") {
  output_name = "LLVMWebAssemblyUtils"
  deps = [
    "${llvm_root_dir}llvm/lib/CodeGen",
    "${llvm_root_dir}llvm/lib/IR",
    "${llvm_root_dir}llvm/lib/MC",
    "${llvm_root_dir}llvm/lib/Support",

    # MCTargetDesc depends on Utils, so we can't depend on the full
    # MCTargetDesc target here: it would form a cycle.
    "${llvm_root_dir}llvm/lib/Target/WebAssembly/MCTargetDesc:tablegen",
    "${llvm_root_dir}llvm/lib/Target/WebAssembly/TargetInfo",
  ]
  include_dirs = [ ".." ]
  sources = [ "WebAssemblyTypeUtilities.cpp" ]
}
