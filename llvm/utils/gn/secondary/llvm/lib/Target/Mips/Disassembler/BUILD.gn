import("//build_overrides/llvm.gni")

import("${llvm_root_dir}llvm/utils/TableGen/tablegen.gni")

tablegen("MipsGenDisassemblerTables") {
  visibility = [ ":Disassembler" ]
  args = [ "-gen-disassembler" ]
  td_file = "../Mips.td"
}

llvm_static_library("Disassembler") {
  output_name = "LLVMMipsDisassembler"
  deps = [
    ":MipsGenDisassemblerTables",
    "${llvm_root_dir}llvm/lib/MC/MCDisassembler",
    "${llvm_root_dir}llvm/lib/Support",
    "${llvm_root_dir}llvm/lib/Target/Mips/MCTargetDesc",
    "${llvm_root_dir}llvm/lib/Target/Mips/TargetInfo",
  ]
  include_dirs = [ ".." ]
  sources = [ "MipsDisassembler.cpp" ]
}
