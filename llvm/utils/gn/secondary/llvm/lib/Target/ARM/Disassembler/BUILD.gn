import("//build_overrides/llvm.gni")

import("${llvm_root_dir}llvm/utils/TableGen/tablegen.gni")

tablegen("ARMGenDisassemblerTables") {
  visibility = [ ":Disassembler" ]
  args = [ "-gen-disassembler" ]
  td_file = "../ARM.td"
}

llvm_static_library("Disassembler") {
  output_name = "LLVMARMDisassembler"
  deps = [
    ":ARMGenDisassemblerTables",
    "${llvm_root_dir}llvm/lib/CodeGen",
    "${llvm_root_dir}llvm/lib/MC",
    "${llvm_root_dir}llvm/lib/MC/MCDisassembler",
    "${llvm_root_dir}llvm/lib/Support",
    "${llvm_root_dir}llvm/lib/Target/ARM/MCTargetDesc",
    "${llvm_root_dir}llvm/lib/Target/ARM/Utils",
  ]
  include_dirs = [ ".." ]
  sources = [ "ARMDisassembler.cpp" ]
}
