import("//build_overrides/llvm.gni")

import("${llvm_root_dir}llvm/utils/TableGen/tablegen.gni")

tablegen("SystemZGenDisassemblerTables") {
  visibility = [ ":Disassembler" ]
  args = [ "-gen-disassembler" ]
  td_file = "../SystemZ.td"
}

llvm_static_library("Disassembler") {
  output_name = "LLVMSystemZDisassembler"
  deps = [
    ":SystemZGenDisassemblerTables",
    "${llvm_root_dir}llvm/lib/MC",
    "${llvm_root_dir}llvm/lib/MC/MCDisassembler",
    "${llvm_root_dir}llvm/lib/Support",
    "${llvm_root_dir}llvm/lib/Target/SystemZ/MCTargetDesc",
    "${llvm_root_dir}llvm/lib/Target/SystemZ/TargetInfo",
  ]
  include_dirs = [ ".." ]
  sources = [ "SystemZDisassembler.cpp" ]
}
