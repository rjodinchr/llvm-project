import("//build_overrides/llvm.gni")

llvm_static_library("lib") {
  output_name = "LLVMOptDriver"
  deps = [
    "${llvm_root_dir}llvm/include/llvm/Config:llvm-config",
    "${llvm_root_dir}llvm/lib/Analysis",
    "${llvm_root_dir}llvm/lib/Bitcode/Writer",
    "${llvm_root_dir}llvm/lib/CodeGen",
    "${llvm_root_dir}llvm/lib/IR",
    "${llvm_root_dir}llvm/lib/IRPrinter",
    "${llvm_root_dir}llvm/lib/MC",
    "${llvm_root_dir}llvm/lib/Passes",
    "${llvm_root_dir}llvm/lib/Support",
    "${llvm_root_dir}llvm/lib/Target",
    "${llvm_root_dir}llvm/lib/Target:TargetsToBuild",
    "${llvm_root_dir}llvm/lib/TargetParser",
    "${llvm_root_dir}llvm/lib/Transforms/AggressiveInstCombine",
    "${llvm_root_dir}llvm/lib/Transforms/Coroutines",
    "${llvm_root_dir}llvm/lib/Transforms/IPO",
    "${llvm_root_dir}llvm/lib/Transforms/Instrumentation",
    "${llvm_root_dir}llvm/lib/Transforms/ObjCARC",
    "${llvm_root_dir}llvm/lib/Transforms/Scalar",
    "${llvm_root_dir}llvm/lib/Transforms/Utils",
    "${llvm_root_dir}llvm/lib/Transforms/Vectorize",
  ]
  sources = [
    "NewPMDriver.cpp",
    "optdriver.cpp",
  ]
}

llvm_executable("opt") {
  sources = [ "opt.cpp" ]
  deps = [ ":lib" ]

  # Support plugins.
  # FIXME: Disable dead stripping once other binaries are dead-stripped.
  if (host_os != "mac" && host_os != "win") {
    # Corresponds to export_executable_symbols() in cmake.
    ldflags = [ "-rdynamic" ]
  }
}
