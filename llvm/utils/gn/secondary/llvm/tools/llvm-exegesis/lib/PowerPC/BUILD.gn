import("//build_overrides/llvm.gni")

import("${llvm_root_dir}llvm/utils/TableGen/tablegen.gni")

tablegen("PPCGenExegesis") {
  args = [ "-gen-exegesis" ]
  td_file = "${llvm_root_dir}llvm/lib/Target/PowerPC/PPC.td"
}

llvm_static_library("PowerPC") {
  output_name = "LLVMExegesisPowerPC"
  deps = [
    ":PPCGenExegesis",
    "${llvm_root_dir}llvm/lib/CodeGen",
    "${llvm_root_dir}llvm/lib/TargetParser",

    # Exegesis reaches inside the Target/PowerPC tablegen internals and must
    # depend on these Target/PowerPC-internal build targets.
    "${llvm_root_dir}llvm/lib/Target/PowerPC/MCTargetDesc",
  ]
  sources = [ "Target.cpp" ]
  include_dirs = [ "${llvm_root_dir}llvm/lib/Target/PowerPC" ]
}
