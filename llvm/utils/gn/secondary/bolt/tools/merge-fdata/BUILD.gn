import("//build_overrides/llvm.gni")

llvm_executable("merge-fdata") {
  configs += [ "${llvm_root_dir}llvm/utils/gn/build:bolt_code" ]
  deps = [
    "${llvm_root_dir}llvm/include/llvm/IR:public_tablegen",
    "${llvm_root_dir}llvm/lib/Support",
  ]
  sources = [ "merge-fdata.cpp" ]

  # Emit relocations for BOLT meta test
  # (bolt/test/runtime/meta-merge-fdata.test)
  if (current_os == "linux") {
    ldflags = [ "-Wl,--emit-relocs" ]
  }
}
