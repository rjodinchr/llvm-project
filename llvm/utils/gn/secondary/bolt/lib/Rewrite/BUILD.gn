import("//build_overrides/llvm.gni")

import("${llvm_root_dir}llvm/lib/Target/targets.gni")

llvm_static_library("Rewrite") {
  output_name = "LLVMBOLTRewrite"
  configs += [ "${llvm_root_dir}llvm/utils/gn/build:bolt_code" ]
  deps = [
    "${llvm_root_dir}bolt/lib/Core",
    "${llvm_root_dir}bolt/lib/Passes",
    "${llvm_root_dir}bolt/lib/Profile",
    "${llvm_root_dir}bolt/lib/RuntimeLibs",
    "${llvm_root_dir}bolt/lib/Utils",
    "${llvm_root_dir}llvm/lib/CodeGen/AsmPrinter",
    "${llvm_root_dir}llvm/lib/DWARFLinker",
    "${llvm_root_dir}llvm/lib/DWARFLinker/Classic",
    "${llvm_root_dir}llvm/lib/DWP",
    "${llvm_root_dir}llvm/lib/DebugInfo/DWARF",
    "${llvm_root_dir}llvm/lib/ExecutionEngine/JITLink",
    "${llvm_root_dir}llvm/lib/MC",
    "${llvm_root_dir}llvm/lib/Object",
    "${llvm_root_dir}llvm/lib/Support",
    "${llvm_root_dir}llvm/lib/TargetParser",
    "${llvm_root_dir}llvm/utils/gn/build/libs/pthread",
  ]
  sources = [
    "BinaryPassManager.cpp",
    "BoltDiff.cpp",
    "BuildIDRewriter.cpp",
    "DWARFRewriter.cpp",
    "ExecutableFileMemoryManager.cpp",
    "JITLinkLinker.cpp",
    "LinuxKernelRewriter.cpp",
    "MachORewriteInstance.cpp",
    "MetadataManager.cpp",
    "PseudoProbeRewriter.cpp",
    "RewriteInstance.cpp",
    "SDTRewriter.cpp",
  ]

  defines = []
  if (llvm_build_AArch64) {
    defines += [ "AARCH64_AVAILABLE" ]
    deps += [ "${llvm_root_dir}bolt/lib/Target/AArch64" ]
  }
  if (llvm_build_X86) {
    defines += [ "X86_AVAILABLE" ]
    deps += [ "${llvm_root_dir}bolt/lib/Target/X86" ]
  }
}
