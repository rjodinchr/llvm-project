import("//build_overrides/llvm.gni")

llvm_static_library("X86") {
  output_name = "LLVMBOLTTargetX86"
  configs += [ "${llvm_root_dir}llvm/utils/gn/build:bolt_code" ]
  deps = [
    "${llvm_root_dir}bolt/lib/Core",
    "${llvm_root_dir}bolt/lib/Utils",
    "${llvm_root_dir}llvm/lib/MC",
    "${llvm_root_dir}llvm/lib/MC/MCDisassembler",
    "${llvm_root_dir}llvm/lib/Support",
    "${llvm_root_dir}llvm/lib/Target/X86/MCTargetDesc",
  ]
  sources = [
    "X86MCPlusBuilder.cpp",
    "X86MCSymbolizer.cpp",
  ]

  # This target reaches into the internal headers of LLVM's X86 library.
  include_dirs = [ "${llvm_root_dir}llvm/lib/Target/X86" ]
}
